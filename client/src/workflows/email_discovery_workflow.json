        "path": "contact"
      }
    },
    {
      "id": "function_node-1",
      "type": "function_node",
      "position": {
        "x": 1300,
        "y": 100
      },
      "data": {
        "code": "function process(input) {\n  // Ensure we have an array\n  const contacts = Array.isArray(input) ? input : [input];\n  \n  // Format the lead data\n  return contacts.map(contact => {\n    return {\n      name: contact.name || 'Unknown',\n      title: contact.title || 'Unknown',\n      company: contact.company || 'Unknown',\n      email: contact.email || 'Unknown',\n      linkedIn: contact.linkedIn || '',\n      phone: contact.phone || '',\n      emailConfidence: contact.emailConfidence || 0,\n      verificationStatus: contact.emailVerificationStatus || 'unknown'\n    };\n  });\n}"
      }
    },
    {
      "id": "text_formatter-1",
      "type": "text_formatter",
      "position": {
        "x": 1600,
        "y": 100
      },
      "data": {
        "format": "csv",
        "options": {
          "header": true,
          "delimiter": ",",
          "columns": ["name", "title", "company", "email", "linkedIn", "phone", "emailConfidence", "verificationStatus"]
        }
      }
    }
  ],
