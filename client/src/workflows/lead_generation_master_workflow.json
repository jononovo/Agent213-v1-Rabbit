      "data": {
        "code": "function process(input) {\n  // Extract and process the target titles\n  const titles = input.targetTitles.split(',').map(title => title.trim()).filter(title => title.length > 0);\n  return {\n    ...input,\n    processedTitles: titles\n  };\n}"
      }
    },
