      "data": {
        "code": "function process(input) {\n  // Extract data from webhook payload\n  const payload = input.payload || {};\n  \n  return {\n    searchQuery: payload.searchQuery || '',\n    targetTitles: payload.targetTitles || 'CEO, CTO, VP of Engineering, VP of Marketing, VP of Sales',\n    maxResults: payload.maxResults || 10,\n    includeLinkedIn: payload.includeLinkedIn !== false,\n    includeEmail: payload.includeEmail !== false,\n    includePhone: payload.includePhone === true,\n    webhookUrl: payload.webhookUrl,\n    exportFormat: payload.exportFormat || 'json'\n  };\n}"
      }
    },
